{
  "name": "@rageshpikalmunde/rp-image-editor-react",
  "version": "1.6.1",
  "description": "React image editor and annotation component (rp-image-editor): crop, rotate, draw, text, shapes, callouts, filters and multi-image editing. Accessible and mobile-ready.",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs && npm run build:types",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:types": "tsc -p tsconfig.types.json",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "react-image-editor",
    "react-photo-editor",
    "react-image-crop",
    "react-image-annotation",
    "image-editor",
    "photo-editor",
    "image-annotation",
    "image-cropper",
    "screenshot-annotation",
    "multi-image",
    "image-filters",
    "accessible",
    "fabricjs",
    "react",
    "ionic",
    "ionic-react",
    "capacitor",
    "typescript"
  ],
  "author": "Ragesh Pikalmunde",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@rageshpikalmunde/rp-image-editor": "^1.6.1"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "devDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@types/react": "^18.2.0",
    "typescript": "~5.3.0"
  },
  "homepage": "https://rpragesh.github.io/image-editor/react-image-editor/",
  "repository": {
    "type": "git",
    "url": "https://github.com/rpragesh/image-editor.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/rpragesh/image-editor/issues"
  }
}
