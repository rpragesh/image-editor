{
  "name": "@rageshpikalmunde/rp-image-editor-angular",
  "version": "1.5.13",
  "description": "Angular wrapper for rp-image-editor with crop, annotation, filters, and native-resolution export support",
  "scripts": {
    "build": "node scripts/build.js",
    "clean": "rm -rf dist",
    "prepublishOnly": "node -e \"console.error(\\\"Publish the built package instead: npm run build && npm publish ./dist\\\"); process.exit(1)\""
  },
  "keywords": [
    "image-editor",
    "angular-image-editor",
    "angular-photo-editor",
    "image-annotation",
    "screenshot-annotation",
    "crop",
    "draw",
    "shapes",
    "callout",
    "fabricjs",
    "angular",
    "ionic",
    "ionic-angular",
    "capacitor"
  ],
  "author": "Ragesh Pikalmunde",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@rageshpikalmunde/rp-image-editor": "^1.5.13"
  },
  "peerDependencies": {
    "@angular/core": ">=15.0.0",
    "@angular/common": ">=15.0.0",
    "@ionic/angular": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "@ionic/angular": {
      "optional": true
    }
  },
  "sideEffects": false
}
