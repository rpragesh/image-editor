{
  "name": "@rageshpikalmunde/rp-image-editor-angular",
  "version": "1.6.1",
  "description": "Angular image editor and annotation component (rp-image-editor): crop, rotate, draw, text, shapes, callouts, filters and multi-image editing. Accessible and mobile-ready.",
  "scripts": {
    "build": "node scripts/build.js",
    "clean": "rm -rf dist",
    "prepublishOnly": "node -e \"console.error(\\\"Publish the built package instead: npm run build, then cd dist && npm publish\\\"); process.exit(1)\""
  },
  "keywords": [
    "angular-image-editor",
    "angular-photo-editor",
    "angular-image-crop",
    "angular-image-annotation",
    "image-editor",
    "photo-editor",
    "image-annotation",
    "image-cropper",
    "screenshot-annotation",
    "multi-image",
    "image-filters",
    "accessible",
    "fabricjs",
    "angular",
    "ionic",
    "ionic-angular",
    "capacitor",
    "typescript"
  ],
  "author": "Ragesh Pikalmunde",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@rageshpikalmunde/rp-image-editor": "^1.6.1"
  },
  "peerDependencies": {
    "@angular/core": ">=15.0.0",
    "@angular/common": ">=15.0.0",
    "@ionic/angular": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "@ionic/angular": {
      "optional": true
    }
  },
  "sideEffects": false,
  "homepage": "https://rpragesh.github.io/image-editor/angular-image-editor/",
  "repository": {
    "type": "git",
    "url": "https://github.com/rpragesh/image-editor.git",
    "directory": "packages/angular"
  },
  "bugs": {
    "url": "https://github.com/rpragesh/image-editor/issues"
  }
}
