{
  "name": "@rageshpikalmunde/rp-image-editor",
  "version": "1.6.1",
  "description": "Open-source image editor and annotation tool for JavaScript, React and Angular: crop, rotate, draw, text, shapes, callouts, filters and multi-image editing. Accessible (WCAG 2.2 AA), mobile-ready, built on Fabric.js.",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "unpkg": "dist/browser/rp-image-editor.min.js",
  "jsdelivr": "dist/browser/rp-image-editor.min.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/cjs/index.js"
    },
    "./styles": "./dist/styles/rp-image-editor.css",
    "./browser": "./dist/browser/rp-image-editor.min.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs && npm run build:types && npm run build:css && npm run build:browser",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:types": "tsc -p tsconfig.types.json",
    "build:css": "node scripts/build-css.js",
    "build:browser": "node scripts/build-browser.js",
    "dev": "tsc -p tsconfig.esm.json --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "docs:api": "typedoc"
  },
  "keywords": [
    "image-editor",
    "photo-editor",
    "image-annotation",
    "annotation-tool",
    "image-cropper",
    "image-crop",
    "screenshot-annotation",
    "image-markup",
    "react-image-editor",
    "angular-image-editor",
    "vue-image-editor",
    "javascript-image-editor",
    "typescript",
    "multi-image",
    "batch-image-editor",
    "image-filters",
    "draw-on-image",
    "text-on-image",
    "callout",
    "arrow-annotation",
    "accessible",
    "wcag",
    "mobile-image-editor",
    "heic",
    "fabricjs",
    "canvas",
    "ionic",
    "capacitor"
  ],
  "author": "Ragesh Pikalmunde",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rpragesh/image-editor.git",
    "directory": "packages/core"
  },
  "homepage": "https://rpragesh.github.io/image-editor/",
  "bugs": {
    "url": "https://github.com/rpragesh/image-editor/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/rpragesh"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {
    "fabric": "^5.3.0"
  },
  "optionalDependencies": {
    "heic2any": "^0.0.4"
  },
  "devDependencies": {
    "esbuild": "^0.27.7",
    "typedoc": "^0.25.13",
    "typescript": "~5.3.0"
  },
  "sideEffects": false
}
